# The tokens `mise run publish` publishes with (see docs/development.md, decision 11). Copy this
# file to `.env` (ignored by Git) and fill them in; scripts/publish.ts reads them from there and
# gives each only to the command that needs it, never printing it. `mise run publish:dry` needs
# neither. Never commit `.env`, nor put a token in any other file.

# An npm access token of the frodobaggins.jr account that may publish (a granular token with
# read and write on @frodobaggins.jr/*, or an automation token).
NPM_TOKEN=

# A crates.io API token with the publish-new and publish-update scopes.
CRATES_IO_TOKEN=
