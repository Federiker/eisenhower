{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eisenhower",
  "mainBinaryName": "eisenhower",
  "identifier": "org.eisenhower.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1441",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Eisenhower",
        "decorations": false,
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480,
        "backgroundColor": "#f5f6f3"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["ike"],
        "name": "Eisenhower.Document",
        "description": "Eisenhower document",
        "role": "Editor",
        "mimeType": "application/x-eisenhower",
        "exportedType": {
          "identifier": "org.eisenhower.desktop.document",
          "conformsTo": ["public.json"]
        }
      }
    ]
  }
}
